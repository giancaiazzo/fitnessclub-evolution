# Desarrollo local: dejala vacía para utilizar el proxy de Vite.
# Si el frontend se ejecuta fuera de Docker, también puede contener la URL
# pública del backend sin una barra final.
VITE_API_URL=

# Producción en el VPS. Generá cuatro valores diferentes con:
# openssl rand -hex 32
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# Clave compartida exclusivamente entre el backend y n8n. No es un token de Meta.
N8N_API_KEY=
# URL interna del Webhook publicado que recibe el alta o cambio de rutina.
N8N_ROUTINE_WEBHOOK_URL=http://n8n:5678/webhook/rutina-asignada

# Control de acceso Hikvision. BaseUrl apunta al puerto externo restringido a
# la IP del VPS. Las credenciales reales viven únicamente en el .env del VPS.
HIKVISION_ENABLED=false
HIKVISION_BASE_URL=
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
HIKVISION_ALLOW_INVALID_CERTIFICATE=false
HIKVISION_TIMEOUT_SECONDS=10

# Correo de recuperación de administradores. Usá una contraseña de aplicación
# o credencial SMTP, nunca la contraseña personal de la casilla.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=FitnessClubEvolution

# Cuentas existentes que podrán recuperar el acceso. Cambiá los usuarios si en
# tu base tienen otro nombre; los correos reales viven solo en el .env del VPS.
RECOVERY_RODRIGO_USERNAME=RodrigoGue
RECOVERY_RODRIGO_EMAIL=
RECOVERY_PAOLA_USERNAME=PaoMu
RECOVERY_PAOLA_EMAIL=
