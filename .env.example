# Desarrollo local: dejala vacía para utilizar el proxy de Vite.
# Si el frontend se ejecuta fuera de Docker, también puede contener la URL
# pública del backend sin una barra final.
VITE_API_URL=

# Producción en el VPS. Generá tres valores diferentes con:
# openssl rand -hex 32
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
